# Variáveis de ambiente da API. Exemplo sem dados reais.
# A aplicação NÃO lê este arquivo nem um .env: exporte as variáveis no shell
# antes de iniciar (comandos no README, seção "Executar localmente").
# Nunca versione um .env com valores reais (.env já está no .gitignore).

# URL do banco no formato do SQLAlchemy. Opcional.
# Padrão: sqlite:///maquina_cafe.db (arquivo na pasta onde a API é iniciada).
# Definida com valor vazio, a aplicação não inicia.
MAQUINA_CAFE_DATABASE_URL=sqlite:///maquina_cafe.db
